{
  "name": "docker2web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:integration": "tsx scripts/integration.ts",
    "init": "node scripts/init.mjs",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:prepare": "node scripts/prepare-integration.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
