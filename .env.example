# Default: local-only initial setup.
PDM_BIND_IP=127.0.0.1
PDM_PORT=3100
APP_ORIGIN=http://127.0.0.1:3100
# Docker Desktop container-side socket (not ~/.docker/run/docker.sock).
DOCKER_SOCKET_PATH=/var/run/docker.sock
# For remote access through your NPM, use one canonical HTTPS APP_ORIGIN.
# Then choose a binding accessible from NPM after reviewing your network policy.
# PDM_BIND_IP=0.0.0.0
# APP_ORIGIN=https://manager.example.com
